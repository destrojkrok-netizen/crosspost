{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crosspost",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Posts, channels, tokens, metrics. Create it once: `npx wrangler d1 create crosspost`,
  // paste the id below, then `npm run db:migrate` (remote) / `npm run db:migrate:local`.
  "d1_databases": [
    { "binding": "DB", "database_name": "crosspost", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  // Uploaded media. Create once: `npx wrangler r2 bucket create crosspost-media`.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "crosspost-media" }],
  // Every minute: publish due posts. Hourly: pull views / likes / followers into `metrics`.
  "triggers": { "crons": ["* * * * *", "5 * * * *"] },
  // Non-secret config. Secrets via `npx wrangler secret put <NAME>`: TOKEN_KEY, CRON_SECRET,
  // THREADS_APP_ID, THREADS_APP_SECRET, X_CLIENT_ID, X_CLIENT_SECRET, TIKTOK_CLIENT_KEY,
  // TIKTOK_CLIENT_SECRET, IG_APP_ID, IG_APP_SECRET.
  "vars": {
    "APP_URL": "https://crosspost.REPLACE.workers.dev",
    "MEDIA_PUBLIC_URL": ""
  }
}
