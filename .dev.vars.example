# Copy to .dev.vars — read by `next dev` (through wrangler) and `npm run cf:preview`.
APP_URL=http://localhost:3000
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored tokens.
TOKEN_KEY=
CRON_SECRET=dev
# Public base URL for uploaded media (R2 public bucket or custom domain). Empty = served
# by this app at /api/media/<key>, which platforms can only fetch once deployed.
MEDIA_PUBLIC_URL=

# Meta app → Threads API use case. Redirect URI: <APP_URL>/api/connect/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
# X developer portal → OAuth 2.0 (Web App). Callback: <APP_URL>/api/connect/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# TikTok developers → Content Posting API. Redirect: <APP_URL>/api/connect/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Meta app → Instagram API with Instagram Login. Redirect: <APP_URL>/api/connect/instagram/callback
IG_APP_ID=
IG_APP_SECRET=

# Google sign-in (console.cloud.google.com → OAuth client, Web). Redirect: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict sign-in to these accounts (empty = anyone with a Google account)
ALLOWED_EMAILS=
# Accounts that inherit channels created before sign-in existed
OWNER_EMAILS=you@gmail.com
# Session signing key (falls back to TOKEN_KEY)
SESSION_SECRET=

# Password reset emails via Resend (resend.com → API key). Without it, dev mode prints the link.
RESEND_API_KEY=
MAIL_FROM=Crosspost <onboarding@resend.dev>
